APP_ENV=development

API_HOST=0.0.0.0

API_PORT=8000

# SQLite works out of the box for local development. Use PostgreSQL in shared/production environments.
DATABASE_URL=sqlite:///./evalai.db
SECRET_KEY=replace-with-long-random-secret

UPLOAD_DIR=./storage/uploads

MAX_UPLOAD_MB=10

OCR_PROVIDER=paddleocr

LLM_PROVIDER=none

LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

FRONTEND_ORIGIN=http://localhost:3000